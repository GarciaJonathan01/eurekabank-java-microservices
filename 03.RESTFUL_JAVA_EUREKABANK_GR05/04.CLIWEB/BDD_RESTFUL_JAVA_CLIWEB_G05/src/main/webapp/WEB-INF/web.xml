<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
   version="6.0"
   metadata-complete="false">
    <display-name>EurekaBank Web Client REST</display-name>
    
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    
    <!-- Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>ec.edu.monster.vista.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>MenuServlet</servlet-name>
        <servlet-class>ec.edu.monster.vista.MenuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MenuServlet</servlet-name>
        <url-pattern>/menu</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>MovimientosServlet</servlet-name>
        <servlet-class>ec.edu.monster.vista.MovimientosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MovimientosServlet</servlet-name>
        <url-pattern>/movimientos</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>DepositoServlet</servlet-name>
        <servlet-class>ec.edu.monster.vista.DepositoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DepositoServlet</servlet-name>
        <url-pattern>/deposito</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>RetiroServlet</servlet-name>
        <servlet-class>ec.edu.monster.vista.RetiroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RetiroServlet</servlet-name>
        <url-pattern>/retiro</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>TransferenciaServlet</servlet-name>
        <servlet-class>ec.edu.monster.vista.TransferenciaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TransferenciaServlet</servlet-name>
        <url-pattern>/transferencia</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>ec.edu.monster.vista.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <error-page>
        <error-code>404</error-code>
        <location>/login.jsp</location>
    </error-page>
</web-app>

